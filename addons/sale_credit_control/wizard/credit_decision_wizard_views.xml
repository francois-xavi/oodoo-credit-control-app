<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="credit_decision_wizard_view_form" model="ir.ui.view">
        <field name="name">credit.decision.wizard.form</field>
        <field name="model">credit.decision.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="order_id" invisible="1"/>
                <field name="decision" invisible="1"/>
                <field name="currency_id" invisible="1"/>

                <div class="alert alert-danger" role="alert" invisible="not block_reason">
                    <div class="fw-bold">Motif du blocage</div>
                    <field name="block_reason"/>
                </div>

                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="amount_total"/>
                    <field name="salesperson_id"/>
                    <field name="request_note" invisible="decision == 'request'"/>
                </group>

                <label for="reason" string="Justification de la demande" invisible="decision != 'request'"/>
                <label for="reason" string="Motif de l'approbation" invisible="decision != 'approved'"/>
                <label for="reason" string="Motif du refus" invisible="decision != 'refused'"/>
                <field name="reason" nolabel="1"
                       placeholder="Ex. : client historique, paiement promis vendredi, acompte de 30 % reçu..."/>

                <footer>
                    <button name="action_validate" type="object" string="Envoyer la demande"
                            class="btn-primary" invisible="decision != 'request'"/>
                    <button name="action_validate" type="object" string="Approuver"
                            class="btn-success" invisible="decision != 'approved'"/>
                    <button name="action_validate" type="object" string="Refuser"
                            class="btn-danger" invisible="decision != 'refused'"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
